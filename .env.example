# CURSOR_API_KEY: Required for Cursor SDK itinerary generation.
CURSOR_API_KEY="YOUR_CURSOR_API_KEY"

# CURSOR_MODEL: Optional model id for Agent.prompt (default: composer-2.5)
CURSOR_MODEL="composer-2.5"

# --- Token budget (Bitácor share of your Cursor daily plan) ---
# Set your Cursor plan daily token allotment to enable hard blocking.
# Leave empty/0 to only measure + log (no block).
CURSOR_PLAN_DAILY_TOKEN_LIMIT="2000000"
# Fraction of that plan Bitácor may use (default 0.4 → keeps ~60% for IDE/other).
# Clamped below 1.0 so Bitácor never defaults to 100% of the plan.
CURSOR_APP_BUDGET_RATIO="0.4"
# Max Agent.prompt calls per local calendar day (safety net if usage missing).
CURSOR_DAILY_RUN_BUDGET="20"
# Skip expensive geo re-prompt (soft tips only). Set false to enable geo repair.
CURSOR_DISABLE_GEO_REPAIR="true"
# Cap OSM places injected into the itinerary prompt.
CURSOR_MAX_PLACES_IN_PROMPT="12"
# Proposal cache TTL in minutes (same config → 0 tokens).
CURSOR_PROPOSALS_CACHE_TTL_MIN="180"
# Categories cache TTL in minutes.
CURSOR_CATEGORIES_CACHE_TTL_MIN="1440"

# Place enrichment uses free OpenStreetMap (Nominatim + Overpass) for ANY destination — no key required.
# GOOGLE_PLACES_API_KEY: Optional. Better city autocomplete + soft supplement if OSM returns few POIs.
# (GOOGLE_MAPS_API_KEY is accepted as an alias.)
GOOGLE_PLACES_API_KEY="YOUR_GOOGLE_PLACES_API_KEY"

# Client Google Maps (Vite): embedded maps in Trip / Result spots / activity hover.
# Enable "Maps JavaScript API" in Cloud Console. Restrict key by HTTP referrer.
# Without this key, UI shows “Open in Google Maps” fallback (no Leaflet).
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_JS_API_KEY"
# Optional Map ID for Advanced Markers (Cloud Console → Map Management). Defaults to DEMO_MAP_ID.
# VITE_GOOGLE_MAPS_MAP_ID="YOUR_MAP_ID"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
