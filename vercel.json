{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/bitacor-ai/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/bitacor-ai/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/bitacor-ai/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/bitacor-ai",
      "destination": "/index.html"
    },
    {
      "source": "/bitacor-ai/",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    }
  }
}
