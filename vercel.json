{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/",
      "destination": "/bitacor-ai/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/bitacor-ai",
      "destination": "/api"
    },
    {
      "source": "/bitacor-ai/:path*",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "dist/**"
    }
  }
}
