{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "destination": "/bitacor-ai/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/bitacor-ai/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/bitacor-ai/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/bitacor-ai/api/places/autocomplete",
      "destination": "/api/places/autocomplete"
    },
    {
      "source": "/bitacor-ai/api/destination-categories",
      "destination": "/api/destination-categories"
    },
    {
      "source": "/bitacor-ai/api/generate-proposals",
      "destination": "/api/generate-proposals"
    },
    {
      "source": "/bitacor-ai",
      "destination": "/index.html"
    },
    {
      "source": "/bitacor-ai/",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/places/autocomplete.ts": {
      "maxDuration": 15,
      "memory": 512
    },
    "api/destination-categories.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/generate-proposals.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/health.ts": {
      "maxDuration": 5,
      "memory": 256
    }
  }
}
