{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/places/autocomplete.ts": {
      "maxDuration": 15,
      "memory": 512
    },
    "api/destination-categories.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "api/_handlers.cjs"
    },
    "api/generate-proposals.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "api/_handlers.cjs"
    },
    "api/health.ts": {
      "maxDuration": 5,
      "memory": 256
    }
  }
}
